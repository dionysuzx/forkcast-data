{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.forkcast.org/schemas/catalog.schema.json",
  "type": "object",
  "required": ["version", "generated_at", "records"],
  "properties": {
    "version": { "const": 1 },
    "generated_at": { "type": "string" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "title", "manifest_path", "updated_at"]
      }
    }
  }
}
