{
  "name": "@forkcast/data-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "forkcast-data": "./dist-ts/src/cli.js",
    "forkcast-mcp": "./dist-ts/src/mcp/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "ingest": "tsx src/cli.ts ingest",
    "derive": "tsx src/cli.ts derive",
    "backfill": "tsx src/cli.ts backfill",
    "validate": "tsx src/cli.ts validate",
    "build-snapshot": "tsx src/cli.ts build-snapshot",
    "build-search": "tsx src/cli.ts build-search",
    "run-evals": "tsx src/cli.ts run-evals",
    "build-site": "tsx src/cli.ts build-site",
    "compact-dist": "tsx src/cli.ts compact-dist",
    "dev:site": "tsx src/site/dev-server.ts",
    "publish": "tsx src/cli.ts publish",
    "dispatch-astro": "tsx src/cli.ts dispatch-astro",
    "dummy:e2e": "ENABLE_DUMMY_PIPELINE=true tsx src/cli.ts dummy-e2e",
    "mcp": "tsx src/mcp/server.ts",
    "verify": "npm run typecheck && npm run test && npm run validate && npm run build-snapshot && npm run build-search && npm run run-evals && npm run build-site && npm run compact-dist && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@netlify/functions": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
